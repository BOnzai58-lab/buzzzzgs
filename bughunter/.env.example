# BugHunter AI — Environment Variables Template
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
#
# See: Review Report §2.2 — Secrets and deployment defaults

# ── Database ─────────────────────────────────────────────────────────────────
# For Docker: use db as hostname. For local: use localhost.
DATABASE_URL=postgresql+asyncpg://<DB_USER>:<DB_PASSWORD>@localhost:5432/<DB_NAME>
SYNC_DATABASE_URL=postgresql+psycopg2://<DB_USER>:<DB_PASSWORD>@localhost:5432/<DB_NAME>

# SQLite for local dev (no Postgres needed):
# DATABASE_URL=sqlite+aiosqlite:///./bughunter.db
# SYNC_DATABASE_URL=sqlite:///./bughunter.db

# ── PostgreSQL (Docker Compose) ───────────────────────────────────────────────
POSTGRES_USER=bughunter
POSTGRES_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
POSTGRES_DB=bughunter

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<CHANGE_ME_GENERATE_WITH_SECRETS_MODULE>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── AI Configuration ──────────────────────────────────────────────────────────
# Supports: OpenAI, OpenRouter, Groq, local Ollama
# Never log or include the API key in reports
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=<YOUR_API_KEY_HERE>
AI_MODEL=gpt-4o-mini

# ── App ───────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000
DEBUG=false

# ── Evidence / Report Storage ─────────────────────────────────────────────────
EVIDENCE_DIR=./data/evidence
REPORT_DIR=./data/reports
