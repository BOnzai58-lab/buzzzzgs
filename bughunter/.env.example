# BugHunter AI — Environment Variables
# Copy this to .env and fill in your values

# --- Database ---
DATABASE_URL=postgresql+asyncpg://bughunter:bughunter@db:5432/bughunter
SYNC_DATABASE_URL=postgresql+psycopg2://bughunter:bughunter@db:5432/bughunter

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI Configuration (Standard OpenAI-compatible API) ---
# Works with OpenAI, OpenRouter, Groq, or local Ollama
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your_api_key_here
AI_MODEL=gpt-4o-mini

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3000

# --- Evidence & Report Storage ---
EVIDENCE_DIR=/data/evidence
REPORT_DIR=/data/reports
